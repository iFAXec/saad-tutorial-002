<div class="featured-collection">
    <h2 class="fc-heading">{{ section.settings.featured_title }}</h2>

    <div class="fc-grid">
        {% if section.settings.featured_collection and section.settings.featured_collection.products.size > 0 %}
        {% for product in section.settings.featured_collection.products %}
        <article class="fc-card">
            <a class="fc-link" href="{{ product.url }}">
                <div class="fc-image" role="img" aria-label="{{ product.title }}">
                    {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '400' }}"
                        alt="{{ product.featured_image.alt | default: product.title }}"
                        style="width:100%;height:100%;object-fit:cover;display:block;">
                    {% else %}
                    <div
                        style="width:100%;height:100%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;color:#666;font-size:14px;">
                        No Image</div>
                    {% endif %}
                </div>

                <div class="fc-meta">
                    <h3 class="fc-title">{{ product.title }}</h3>
                    <p class="fc-price">{{ product.price | money }}</p>
                </div>
            </a>
        </article>
        {% endfor %}
        {% else %}
        <p>No products found in this collection.</p>`
        {% endif %}
    </div>
</div>


{% schema %}
{
"name": "Featured Collection",
"settings": [
{
"type": "text",
"id": "featured_title",
"label": "Featured_title",
"default": "Featured Collection"
},
{
"type": "collection",
"id": "featured_collection",
"label": "Collection"
}

],

"presets": [
{
"name": "Featured Collection"
}
]
}
{% endschema %}

<style>
    .featured-collection {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        color: #222;
    }

    .fc-heading {
        margin: 0 0 16px;
        font-size: 28px;
        font-weight: 600;
        text-align: left;
    }

    .fc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }

    .fc-card {
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 8px;
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .fc-link {
        color: inherit;
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .fc-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 8px 20px rgba(30, 30, 30, 0.06);
    }

    .fc-image {
        width: 100%;
        height: 160px;
        background-color: #f4f5f7;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .fc-meta {
        padding: 12px 14px 16px;
    }

    .fc-title {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 500;
        color: #111;
    }

    .fc-price {
        margin: 0;
        color: #0a7bff;
        font-weight: 600;
    }

    @media (max-width: 420px) {
        .fc-image {
            height: 120px;
        }

        .fc-heading {
            font-size: 20px;
        }
    }
</style>