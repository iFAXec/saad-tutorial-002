{% schema %}
    {
        "name": "Featured Collection",
        "settings": [
            {
              "type": "text",
              "id": "Featured_id",
              "label": "Featured_label",
              "default": "Featured Collection"
            }
        
        ],

        "presets": [
          {
            "name": "Featured Collection"
          }
        ]
    }
{% endschema %}

<div class="featured-collection">
    <h2 class="fc-heading">{{ section.settings.Featured_id }}</h2>

    <div class="fc-grid">
        {% for i in (1..3) %}
            <article class="fc-card">
                <a class="fc-link" href="#">
                    <div class="fc-image" role="img" aria-label="Product image {{ i }}">
                        <!-- simple SVG placeholder -->
                        <svg width="100%" height="100%" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect width="100%" height="100%" fill="#e9ecef"/>
                            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#adb5bd" font-size="20">Image</text>
                        </svg>
                    </div>

                    <div class="fc-meta">
                        <h3 class="fc-title">Product {{ i }}</h3>
                        <p class="fc-price">$19.99</p>
                    </div>
                </a>
            </article>
        {% endfor %}
    </div>
</div>

<style>
.featured-collection{
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    color: #222;
}

.fc-heading{
    margin: 0 0 16px;
    font-size: 28px;
    font-weight: 600;
    text-align: left;
}

.fc-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}

.fc-card{
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 8px;
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
}

.fc-link{
    color: inherit;
    text-decoration: none;
    display: block;
    height: 100%;
}

.fc-card:hover{
    transform: translateY(-6px);
    box-shadow: 0 8px 20px rgba(30,30,30,0.06);
}

.fc-image{
    width: 100%;
    height: 160px;
    display: block;
    background-color: #f4f5f7;
    display: flex;
    align-items: center;
    justify-content: center;
}

.fc-meta{
    padding: 12px 14px 16px;
}

.fc-title{
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 500;
    color: #111;
}

.fc-price{
    margin: 0;
    color: #0a7bff;
    font-weight: 600;
}
@media (max-width: 420px){
    .fc-image{ height: 120px; }
    .fc-heading{ font-size: 20px; }
}
</style>
