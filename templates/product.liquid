{{product.title}}

<style>
        :root{
            --gap: 24px;
            --max-width: 1100px;
            --accent: #0b74de;
            --muted: #6b7280;
            --radius: 8px;
        }

        body{
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            margin: 32px;
            display: flex;
            justify-content: center;
        }

        .product-page{
            display: flex;
            gap: var(--gap);
            max-width: var(--max-width);
            width: 100%;
            align-items: flex-start;
        }

        /* Left: image gallery */
        .gallery{
            flex: 1 1 50%;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .main-image{
            width: 100%;
            aspect-ratio: 1/1;
            background: #f3f4f6;
            display: grid;
            place-items: center;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: 0 4px 12px rgba(16,24,40,0.06);
        }

        .main-image img{
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .thumbnails{
            display: flex;
            gap: 8px;
            justify-content: flex-start;
        }

        .thumb{
            width: 72px;
            height: 72px;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            box-shadow: 0 2px 6px rgba(16,24,40,0.04);
        }

        .thumb img{
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .thumb.active{
            border-color: var(--accent);
        }

        /* Right: product info */
        .product-info{
            flex: 1 1 50%;
            min-width: 280px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .title{
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .price{
            font-size: 1.25rem;
            color: #111827;
            font-weight: 700;
        }

        .description{
            color: var(--muted);
            line-height: 1.4;
        }

        .buy-box{
            display: flex;
            gap: 12px;
            align-items: center;
            margin-top: 8px;
        }

        .quantity{
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #e5e7eb;
            padding: 6px 8px;
            border-radius: 8px;
        }

        .quantity button{
            background: transparent;
            border: none;
            font-size: 16px;
            width: 28px;
            height: 28px;
            cursor: pointer;
        }

        .add-to-cart{
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 10px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            box-shadow: 0 6px 18px rgba(11,116,222,0.12);
        }

        .add-to-cart:active{ transform: translateY(1px); }

        @media (max-width: 800px){
            .product-page{
                flex-direction: column;
            }
            .gallery, .product-info{ width: 100%; }
            .thumbnails{ overflow-x: auto; }
        }
    </style>

    <main class="product-page" role="main">
        <section class="gallery" aria-label="Product images">
            <div class="main-image" id="mainImage">
                <img src="{{product.featured_image | img_url: '100'}}" alt="Product image">
            </div>
            <div class="thumbnails" id="thumbnails">
                {% for media in product.media %}
                    <div class="thumb active" data-src="{{media.url | img_url: '400'}}">
                        <img src="{{media.preview_image | img_url: '200'}}" alt="{{media.alt | default: 'Product image'}}">
                    </div>
                {% endfor %}
            </div>
        </section>

        <aside class="product-info" aria-label="Product details">
            <h1 class="title">Sample Product Title</h1>
            <div class="price">$49.00</div>
            <p class="description">
                A short description of the product. Highlight key features, materials, and sizing details so customers know what to expect.
            </p>

            <div class="buy-box" aria-hidden="false">
                <div class="quantity" role="group" aria-label="Quantity selector">
                    <button id="qtyMinus" aria-label="Decrease quantity">−</button>
                    <div id="qty" style="min-width:24px; text-align:center;">1</div>
                    <button id="qtyPlus" aria-label="Increase quantity">+</button>
                </div>

                <button class="add-to-cart" id="addToCart">Add to cart</button>
            </div>
        </aside>
    </main>

    <script>
        // Gallery switching
        (function(){
            const mainImg = document.querySelector('#mainImage img');
            const thumbs = document.querySelectorAll('.thumb');

            thumbs.forEach(t => {
                t.addEventListener('click', () => {
                    thumbs.forEach(x => x.classList.remove('active'));
                    t.classList.add('active');
                    const src = t.getAttribute('data-src');
                    mainImg.src = src;
                    mainImg.alt = t.querySelector('img').alt || 'Product image';
                });
            });
        })();

        // Simple quantity and add-to-cart behavior
        (function(){
            const qtyEl = document.getElementById('qty');
            let qty = 1;
            document.getElementById('qtyMinus').addEventListener('click', () => {
                if (qty > 1) { qty--; qtyEl.textContent = qty; }
            });
            document.getElementById('qtyPlus').addEventListener('click', () => {
                qty++; qtyEl.textContent = qty;
            });

            document.getElementById('addToCart').addEventListener('click', () => {
                // Replace with real cart integration in a production environment
                alert('Added ' + qty + ' item(s) to cart (demo)');
            });
        })();
    </script>